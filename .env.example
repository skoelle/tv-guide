# Copy to .env (git-ignored) and fill in. Used by docker-compose.
# Never commit real credentials.
TVGUIDE_SMTP_PASSWORD=
TVGUIDE_TVH_PASSWORD=
# TMDB: bevorzugt der v4 Read Access Token, sonst der v3 API Key.
TVGUIDE_TMDB_READ_TOKEN=
TVGUIDE_TMDB_API_KEY=

# Read-only Diagnose-API (/api/support/...). Ohne Token deaktiviert.
# Optional: TVGUIDE_SUPPORT_SQL=1 erlaubt zusaetzlich einzelne SELECT-Abfragen.
TVGUIDE_SUPPORT_TOKEN=
TVGUIDE_SUPPORT_SQL=0

# GitHub Actions repository secrets (configure in GitHub, not here):
#   WEBHOOK_URL, WEBHOOK_TOKEN   (Watchtower rollout after a build)
